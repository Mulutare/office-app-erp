APP_NAME=OfficeApp ERP
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Africa/Addis_Ababa
APP_COMPANY_CODE=default
APP_PORT=8080
GOOGLE_MAPS_BROWSER_API_KEY=

SESSION_NAME=office_app_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Optional standards-based background Web Push.
# Generate one stable VAPID key pair with:
# php bin/generate-web-push-keys.php
WEB_PUSH_ENABLED=false
WEB_PUSH_SUBJECT=mailto:erp-admin@example.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
API_WEBHOOK_ENCRYPTION_KEY=
# Set to a private, high-entropy production value when storing Power BI client secrets.
POWER_BI_ENCRYPTION_KEY=
WEB_PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,push.services.mozilla.com,web.push.apple.com,*.notify.windows.com

DB_DRIVER=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=office_app_dev
DB_USERNAME=officeapp
DB_PASSWORD=change-this-development-password
DB_ROOT_PASSWORD=change-this-development-root-password
DB_HOST_PORT=3307

# Optional Oracle lab profile. MySQL remains the default.
# Copy docker/oracle/oracle.env.example to a private environment file.
# Do not set DB_DRIVER=oracle in the standard MySQL environment.

DEV_ADMIN_USERNAME=admin
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_DISPLAY_NAME=Platform Administrator
DEV_ADMIN_PASSWORD=Change-This-Development-Admin-2026!
